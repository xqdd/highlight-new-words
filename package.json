{
  "name": "highlight-new-words",
  "description": "有道/欧路生词本与分级词书网页高亮扩展",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:shot": "node scripts/qa/shot.mjs",
    "postinstall": "wxt prepare",
    "build:firefox": "wxt build -b firefox",
    "pack:crx": "wxt build && node scripts/pack-crx.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@wxt-dev/module-vue": "^1.0.3",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "~5.9",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "vue": "^3.5.43"
  }
}
