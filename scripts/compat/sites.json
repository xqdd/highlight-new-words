{
  "$comment": "兼容性/性能测试站点清单，字段说明见 scripts/compat/README.md。live=线上站点；offline=tests/fixtures/sites 下的精简快照（回归用，结果可复现）。",
  "defaults": {
    "kind": "page",
    "settleMs": 8000,
    "forbid": ["pre", "code", "textarea", "input", "select", "[contenteditable]:not([contenteditable=false])", "[role=textbox]"]
  },
  "sites": [
    { "id": "wikipedia", "group": "wikipedia", "name": "维基百科 Photosynthesis", "url": "https://en.wikipedia.org/wiki/Photosynthesis" },
    { "id": "x-home", "group": "x", "name": "X 已登录首页（无限滚动）", "url": "https://x.com/home", "kind": "infinite", "cookies": "x", "settleMs": 10000,
      "note": "只读浏览：只滚动，不点击任何按钮" },
    { "id": "youtube-home", "group": "youtube", "name": "YouTube 首页", "url": "https://www.youtube.com/", "settleMs": 9000 },
    { "id": "youtube-watch", "group": "youtube", "name": "YouTube 视频页（标题/描述/评论）", "url": "https://www.youtube.com/watch?v=UF8uR6Z6KLc", "settleMs": 10000,
      "note": "滚动 3 屏后评论区加载，检查评论是否补标" },
    { "id": "reddit-post", "group": "reddit", "name": "Reddit 帖子（r/science）", "url": "https://www.reddit.com/r/science/comments/1wu65ra/mit_used_ai_to_develop_new_recipe_for_mrna/", "settleMs": 9000 },
    { "id": "reddit-feed", "group": "reddit", "name": "Reddit r/science 列表（无限滚动）", "url": "https://www.reddit.com/r/science/", "kind": "infinite", "settleMs": 9000 },
    { "id": "spring-boot", "group": "docs", "name": "Spring Boot reference: SpringApplication", "url": "https://docs.spring.io/spring-boot/reference/features/spring-application.html" },
    { "id": "medium", "group": "medium", "name": "Medium: Karpathy《Software 2.0》", "url": "https://karpathy.medium.com/software-2-0-a64152b37c35", "settleMs": 9000 },
    { "id": "github-readme", "group": "github", "name": "GitHub README（facebook/react）", "url": "https://github.com/facebook/react",
      "spa": { "click": "#issues-tab, a[data-tab-item='i1issues-tab'], a[href='/facebook/react/issues']", "label": "README→Issues（Turbo 路由）" } },
    { "id": "github-issue", "group": "github", "name": "GitHub issue（react#11347）", "url": "https://github.com/facebook/react/issues/11347" },
    { "id": "github-code", "group": "github", "name": "GitHub 代码页（ReactHooks.js，不应被标注）", "url": "https://github.com/facebook/react/blob/main/packages/react/src/ReactHooks.js",
      "forbid": [".react-code-lines", ".react-code-text", ".react-file-line", "[data-testid=code-cell]", ".blob-code", "#read-only-cursor-text-area"] },
    { "id": "mdn", "group": "docs", "name": "MDN Closures", "url": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Closures" },
    { "id": "stackoverflow", "group": "docs", "name": "Stack Overflow 经典问答（排序数组）", "url": "https://stackoverflow.com/questions/11227809/why-is-processing-a-sorted-array-faster-than-processing-an-unsorted-array", "settleMs": 9000 },
    { "id": "bbc", "group": "news", "name": "BBC News 文章", "url": "https://www.bbc.com/news/articles/cjwyz59k5y75o" },
    { "id": "guardian", "group": "news", "name": "Guardian 文章（欧洲住房危机）", "url": "https://www.theguardian.com/world/2026/sep/30/how-europes-housing-crisis-is-fuelling-a-new-movement" },
    { "id": "hn-front", "group": "hn", "name": "Hacker News 首页", "url": "https://news.ycombinator.com/" },
    { "id": "hn-item", "group": "hn", "name": "Hacker News 评论页（item 8863）", "url": "https://news.ycombinator.com/item?id=8863" },
    { "id": "chatgpt", "group": "chat", "name": "ChatGPT 未登录首页（ProseMirror 输入框）", "url": "https://chatgpt.com/", "settleMs": 9000,
      "editable": ["#prompt-textarea", "[contenteditable=true]", "textarea"], "note": "不输入、不提交" },
    { "id": "claude", "group": "chat", "name": "Claude.ai（未登录）", "url": "https://claude.ai/", "settleMs": 9000, "editable": ["[contenteditable=true]", "textarea"] },
    { "id": "google-search", "group": "google", "name": "Google 搜索结果页", "url": "https://www.google.com/search?q=photosynthesis+light+reactions&hl=en", "settleMs": 7000 },
    { "id": "notion", "group": "notion", "name": "Notion 公开页（Airalo Public Handbook）", "url": "https://airalo-public.notion.site/Airalo-s-Public-Handbook-25396a97ffca81138b08fc56637c32c9", "settleMs": 10000 },
    { "id": "prosemirror", "group": "editable", "name": "ProseMirror 编辑器 demo（公开 contenteditable）", "url": "https://prosemirror.net/examples/basic/",
      "editable": [".ProseMirror"], "typeTest": ".ProseMirror",
      "note": "在本地编辑器里输入一句含考试词的英文（不提交到任何服务器），检查输入区不被标注、文本不被改写" },

    { "id": "off-wikipedia", "group": "offline", "name": "[快照] 维基百科 Photosynthesis", "fixture": "wikipedia-photosynthesis.html", "settleMs": 5000 },
    { "id": "off-spring-boot", "group": "offline", "name": "[快照] Spring Boot reference", "fixture": "spring-boot-application.html", "settleMs": 5000 },
    { "id": "off-github-readme", "group": "offline", "name": "[快照] GitHub README", "fixture": "github-readme.html", "settleMs": 5000 },
    { "id": "off-github-code", "group": "offline", "name": "[快照] GitHub 代码页", "fixture": "github-code.html", "settleMs": 5000,
      "forbid": [".react-code-lines", ".react-code-text", ".react-file-line", "[data-testid=code-cell]", ".blob-code", "#read-only-cursor-text-area"] },
    { "id": "off-mdn", "group": "offline", "name": "[快照] MDN Closures", "fixture": "mdn-closures.html", "settleMs": 5000 },
    { "id": "off-hn-item", "group": "offline", "name": "[快照] Hacker News 评论页", "fixture": "hn-item.html", "settleMs": 5000 },
    { "id": "off-guardian", "group": "offline", "name": "[快照] Guardian 文章", "fixture": "guardian-article.html", "settleMs": 5000 },
    { "id": "off-medium", "group": "offline", "name": "[快照] Medium 文章", "fixture": "medium-article.html", "settleMs": 5000 },
    { "id": "off-editable", "group": "offline", "name": "[手工] 可编辑区（textarea / contenteditable / 类 Gmail 撰写框）", "fixture": "editable.html", "settleMs": 4000,
      "editable": ["textarea", "[contenteditable=true]", "[role=textbox]"], "typeTest": "#compose-body" }
  ]
}
